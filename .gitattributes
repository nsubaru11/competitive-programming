# 既定は LF
* text=auto eol=lf

# Windows 用スクリプトは CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# バイナリ
*.jar binary
*.zip binary
*.gz binary
*.tar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# 差分表示
*.java diff=java
*.cpp diff=cpp
*.cc diff=cpp
*.h diff=cpp
*.hpp diff=cpp
*.py diff=python
*.html diff=html
*.css diff=css
*.js diff=javascript
