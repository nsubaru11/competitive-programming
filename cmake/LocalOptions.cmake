if (UNIX AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
	execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -print-file-name=libstdc++.so
		OUTPUT_VARIABLE cp_gcc_runtime OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
	if (IS_ABSOLUTE "${cp_gcc_runtime}" AND EXISTS "${cp_gcc_runtime}")
		get_filename_component(cp_gcc_runtime "${cp_gcc_runtime}" REALPATH)
		get_filename_component(cp_gcc_runtime_dir "${cp_gcc_runtime}" DIRECTORY)
	endif ()
endif ()

function(cp_configure_solution target site)
	set_target_properties(${target} PROPERTIES CXX_SCAN_FOR_MODULES OFF)
	if (cp_gcc_runtime_dir)
		set_property(TARGET ${target} PROPERTY BUILD_RPATH "${cp_gcc_runtime_dir}")
	endif ()
	target_compile_options(${target} PRIVATE -Wall -Wextra -g3 -fno-omit-frame-pointer)
	target_compile_definitions(${target} PRIVATE LOCAL _GLIBCXX_ASSERTIONS)

	if (site STREQUAL "paiza" OR site STREQUAL "icpc")
		set_property(TARGET ${target} PROPERTY CXX_STANDARD 20)
	endif ()
	if (site STREQUAL "codeforces" OR site STREQUAL "paiza")
		set_property(TARGET ${target} PROPERTY CXX_EXTENSIONS OFF)
	endif ()
	if (site STREQUAL "codeforces")
		target_compile_options(${target} PRIVATE -Wconversion)
		target_compile_definitions(${target} PRIVATE ONLINE_JUDGE)
		target_link_libraries(${target} PRIVATE stdc++exp)
	endif ()
	if (site STREQUAL "atcoder")
		target_compile_definitions(${target} PRIVATE ATCODER NOMINMAX ONLINE_JUDGE)
		target_compile_options(${target} PRIVATE
			-fconstexpr-depth=1024 -fconstexpr-loop-limit=524288 -fconstexpr-ops-limit=2097152
			-fmodules -ftrivial-auto-var-init=zero -pthread -fopenmp
		)
		target_link_options(${target} PRIVATE -pthread -fopenmp -Wl,--as-needed)
		target_link_libraries(${target} PRIVATE stdc++exp)
	endif ()

	if (CMAKE_BUILD_TYPE STREQUAL "Debug")
		target_compile_options(${target} PRIVATE -Og)
	else ()
		target_compile_options(${target} PRIVATE -O2)
		target_compile_options(${target} PRIVATE -march=native)
	endif ()
endfunction()
