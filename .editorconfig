root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml,md}]
indent_style = space
indent_size = 2

# 生成物はビルドで整形するので、先頭の @formatter:off で IDE の整形から外す
[**/dist/*.user.js]
ij_formatter_tags_enabled = true
