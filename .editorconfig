root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 120
ij_continuation_indent_size = 4
ij_smart_tabs = false
ij_wrap_on_typing = false
ij_formatter_tags_enabled = true
ij_formatter_off_tag = @formatter:off
ij_formatter_on_tag = @formatter:on

[*.{java,py,pyw,c,cc,cpp,cxx,h,hpp,js,mjs,cjs,jsx,ts,tsx,mts,cts,json,jsonc,xml,sh,bash,zsh,cmake}]
trim_trailing_whitespace = true

[*.java]
ij_continuation_indent_size = 8
ij_java_use_single_class_imports = false
ij_java_class_count_to_use_import_on_demand = 1
ij_java_names_count_to_use_import_on_demand = 1
# java → javax → com → org → その他 → 自作ライブラリ(lib) → static import の順に並べ、先頭の名前が違うグループの間に空行を置く。
ij_java_layout_static_imports_separately = true
ij_java_imports_layout = java.**, |, javax.**, |, com.**, |, org.**, |, *, |, lib.**, |, $java.**, |, $javax.**, |, $*
# 中身のない record・class・メソッドは「{}」で1行に保つ。
ij_java_keep_simple_classes_in_one_line = true
ij_java_keep_simple_methods_in_one_line = true

[*.{py,pyw}]
ij_python_blank_lines_around_top_level_classes_functions = 1
ij_python_blank_lines_around_class = 1
ij_python_blank_lines_around_method = 1
ij_python_keep_blank_lines_in_code = 1
ij_python_keep_blank_lines_in_declarations = 1
ij_python_keep_indents_on_empty_lines = false
ij_python_align_multiline_parameters = false
ij_python_align_multiline_parameters_in_calls = false
ij_python_align_multiline_imports = false
ij_python_align_collections_and_comprehensions = false

[*.{js,mjs,cjs,jsx}]
ij_javascript_blank_lines_around_function = 1
ij_javascript_blank_lines_around_method = 1
ij_javascript_keep_blank_lines_in_code = 1
ij_javascript_keep_indents_on_empty_lines = false

[*.{ts,tsx,mts,cts}]
ij_typescript_blank_lines_around_function = 1
ij_typescript_blank_lines_around_method = 1
ij_typescript_keep_blank_lines_in_code = 1
ij_typescript_keep_indents_on_empty_lines = false

# tsconfig の {"path": "..."} のような短いオブジェクトは1行のまま残し、既存の改行を保つ。
[*.{json,jsonc}]
ij_json_object_wrapping = off
ij_json_array_wrapping = off
ij_json_keep_line_breaks = true

[*.{bat,cmd,ps1}]
end_of_line = crlf

# PowerShellの波括弧は、if などと同じ行に置き、else・elseif・catch・finally は閉じ括弧に続ける。
# PowerShellのプラグインはタブの設定を .editorconfig から受け取らないため、タブは .ide/idea/.idea/codeStyles/Project.xml で指定する。
[*.{ps1,psm1,psd1}]
ij_powershell_block_brace_style = end_of_line
ij_powershell_class_brace_style = end_of_line
ij_powershell_method_brace_style = end_of_line
ij_powershell_else_on_new_line = false
ij_powershell_special_else_if_treatment = false
ij_powershell_catch_on_new_line = false
ij_powershell_finally_on_new_line = false

# YAMLのインデントと、Markdownのリスト・コードブロックはスペースで管理する。
[*.{yml,yaml,md}]
indent_style = space
indent_size = 2

# Markdownの改行記法と、入出力データの末尾空白を保持する。
[*.{md,txt,in,out,ans}]
trim_trailing_whitespace = false

# Markdownの整形は、表をそろえることと見出しの前後に空行を1行置くことだけにする。
# 長い行の折り返し、空白の詰め、段落・リスト・コードブロックの前後の空行には手を加えない。
[*.md]
max_line_length = off
ij_markdown_wrap_text_if_long = false
ij_markdown_wrap_text_inside_blockquotes = false
ij_markdown_keep_line_breaks_inside_text_blocks = true
ij_markdown_insert_quote_arrows_on_wrap = false
ij_markdown_format_tables = true
ij_markdown_min_lines_around_header = 1
ij_markdown_max_lines_around_header = 1
ij_markdown_min_lines_around_block_elements = 0
ij_markdown_max_lines_around_block_elements = 99
ij_markdown_min_lines_between_paragraphs = 1
ij_markdown_max_lines_between_paragraphs = 99
ij_markdown_force_one_space_between_words = false
ij_markdown_force_one_space_after_header_symbol = false
ij_markdown_force_one_space_after_list_bullet = false
ij_markdown_force_one_space_after_blockquote_symbol = false

# AI向けの指示は、表の桁そろえで行が長くならないよう整形しない。
[{AGENTS.md,CLAUDE.md}]
ij_formatter_enabled = false

# テンプレートは整形しない。templates内のREADMEだけは通常のMarkdownとして整形する。
[templates/**]
ij_formatter_enabled = false

[templates/**/README.md]
ij_formatter_enabled = true

[library/java/docs/{GuideTemplate,README_TEMPLATE,ReferenceTemplate}.md]
ij_formatter_enabled = false

[templates/python/Debug.py]
ij_python_blank_lines_around_top_level_classes_functions = 0
ij_python_keep_blank_lines_in_declarations = 0
